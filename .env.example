######-------------------------------------------------   PM SERVER   -------------------------------------------------------------######
# These are the configs related to the socket server (ProcessManager)
# With these configs we let the PM to be served on a socket. other services will connect to this socket as clients
# There are 2 ways to config the pm server, for each a different set of configs are required.
# 1st is to serve pm on a unix socket file, and the 2nd way is to serve it on a port
# The value of PRCS_MNGR_SOCKET_CLIENT_PORT will determine which way to use. 
# if it is a port range like 5051:5053, the system will know that it's gonna be on port, 
# and if the value is a word like 'client' the system will know that we want a file

#--------------------------------------------------------------------------------------------------

# 1st option: serve socket on a unix file

SOCKET_FILE_PATH=bootstrap/easySocket
# set the path of the file. try not to change the defult value (bootstrap/easySocket)
PRCS_MNGR_SOCKET_CLIENT_PORT=client 
# set the socket file name. so the file will be bootstrap/easySocket/client.sock
# if you remove this config from env the default value will be client. 
#--------------------------------------------------------------------------------------------------

# 2nd option: serve socket on a port

SOCKET_HOST=127.0.0.1
# the ip address that will host the socket
PRCS_MNGR_SOCKET_CLIENT_PORT=4000:4005
# a range (3-4) of consecutive port numbers to try to serve the socket on.
# the system will try to serve on the 1st port and if the port was not 
# available it will automatically switch to the next port in the range.
#** at the end the socket will be served on only 1 of the ports in the range.
#--------------------------------------------------------------------------------------------------

# common configs 

PRCS_MNGR_SOCKET_WORKER_PORT=worker
# the pm will use this config to serve another socket for workers to connect to
# same behavior as PRCS_MNGR_SOCKET_CLIENT_PORT, but since this is an inter service connection it's better to use the 1st way (file)
# so don't change it. or you can just remove it bc the default value is 'worker'
PRCS_MNGR_PROCESS_NUMBER=5
# The number of the workers. Has to be set according to the system's needs.
# Practically the max number of tasks that this service might have to run simultaneously, which is different for
# each service (supplier, crawler, notification, etc), and also in different environments (dev, prod, alpha, etc).
# Too many workers will have a significant effect on the ram usage (even on standby), and too few of them will lead to task failure due to worker shortage.
# It's NOT unlimited. the number of workers plus the number of the clients that will eventually connect
# to the pm, can NOT be more that 1000 (system/socket limitation)
PRCS_MNGR_TASKS_OVERLOAD=0
# this config determines that in an event where all the workers are busy, how many task
# can be accepted to stay in queue and wait for a worker to get free.
# it differs in different services (regardless of the environment). depends on the nature of the service and it's tasks
# the service manager will decide. (it's me, i'm the service manager, ask me before changing it!!!)
PRCS_MNGR_MAX_WOKER_RAM=200
# limits the maximum amount of ram that workers can consume
# if a worker pass it, we will kill the worker after it's task is over and create a new worker instead
# this is only needed in some services like crawler that uses so much ram







######-------------------------------------------------   LUG CONNECTION   -------------------------------------------------------------######
# here we config this service's connection to log-service
# log-service is used to store logs from each process
# these info depends on the http and/or pm server that we have used in log-service

LOG_SERVICE_NAME=Crawler
# Service name. will be stored with the logs that are sent from this service. to show the origin of the log
# obviously it is different in each service
LOG_ERROR_REPORT=true
# if this is true, exceptions that might happen during different processes in this service will
# be logged in log-service, if false they will be handled normally (shows in output)
LOG_SEND_TYPE=socket
# here we determine how the logs should be sent
# the value is either 'socket' (preferred) or 'http'. http is slower but easier to set up in the log-service

# below configs are set if LOG_SEND_TYPE is set to http

LOG_HOST=http://log.api
# the url/ip that will be used to send http logs to.
LOG_APPLICATION=6513fd0b79c18
# determines which log-application we are sending this log to
LOG_REQUEST_TIMEOUT=4000
# time out for curl requests that we send

# below configs are set if LOG_SEND_TYPE is set to socket
# they depend on the pm server that is set for the log application that we wanna use

LOG_SOCKET_HOST=/home/aghaie/projects/log-service/bootstrap/easySocket/client.sock
# if log-application's pm is set to a ip:port, here we'll put the ip adress.
# if the pm is served on a file, we'll put the file's full address here.
LOG_SOCKET_PORT=0
# if log-application's pm is set to a ip:port, here we'll put the port.
# if the pm is served on a file, we'll set 0 for this.









######-------------------------------------------------   CACHER CONNECTION   -------------------------------------------------------------######
# here we config this service's connection to cacher-service
# Cacher-service is the system's central cache.
# We have 6 different cache clusters/connections (so far), each one caches specific data that are used in specific services.
# These cluster are only accessible through socket connections (ES)
# There are 2 ways that the cacher clusters might have been served, each has different configs

# 1st: all served together throuh one socket (only on developement environments)
# in this case we'll have to config the host and port of that one connection
#** if you are using the 1st way make sure to remove the configs of the 2nd way from the env file

MATIN_CACHER_SOCKET_HOST=127.0.0.1
# host configs: if the socket was served on port, the value is an ip address, if it's a file the value is the full path of the file
MATIN_CACHER_SOCKET_PORT=2000:2003
# port configs: if the socket was served on port, the value is the port range like 1000:1003, if it's a file the value is '0'


# 2nd: These cluster are only accessible through socket connections so for each
# cluster a socket has been served in the cacher-service.
#** if you are using the 2nd way make sure to remove the configs of the 1st way from the env file

# host configs: if the socket was served on port, the value is an ip address, if it's a file the value is the full path of the file
# port configs: if the socket was served on port, the value is the port range like 1000:1003, if it's a file the value is '0'

CACHER_CONNECTION_TABLES_HOST=/var/www/cache/bootstrap/easySocket/tables.sock
CACHER_CONNECTION_TABLES_PORT=0
CACHER_CONNECTION_INVENTORY_HOST=/var/www/cache/bootstrap/easySocket/localInventory.sock
CACHER_CONNECTION_INVENTORY_PORT=0
CACHER_CONNECTION_POPULAR_ROUTES_HOST=/var/www/cache/bootstrap/easySocket/popularRoutes.sock
CACHER_CONNECTION_POPULAR_ROUTES_PORT=0
CACHER_CONNECTION_DEFAULT_HOST=/var/www/cache/bootstrap/easySocket/default.sock
CACHER_CONNECTION_DEFAULT_PORT=0
CACHER_CONNECTION_SUBSCRIPTIONS_HOST=/var/www/cache/bootstrap/easySocket/subscriptions.sock
CACHER_CONNECTION_SUBSCRIPTIONS_PORT=0
CACHER_CONNECTION_SUPPLIER_HOST=/var/www/cache/bootstrap/easySocket/supplier.sock
CACHER_CONNECTION_SUPPLIER_PORT=0








######-------------------------------------------------   API CONNECTION   -------------------------------------------------------------######
# to connect to the apiOut-service that handles the webservice for 3rd-party clients and inter-node comunications

API_SEND_TYPE=socket
# determines if we want connection to happen via 'http' or 'socket' (PM)

# this is how we config the socket connection according to the way api's PM was served

API_SOCKET_HOST=/var/www/Api/bootstrap/easySocket/client.sock
# socket host: if the socket was served on port, the value is an ip address, if it's a file the value is the full path of the file
API_SOCKET_PORT=0
# socket port: if the socket was served on port, the value is the port range like 1000:1003, if it's a file the value is '0'

# for http connection we don't need no extra configs here since the url and everything comes from the database







######-------------------------------------------------   MSS CONNECTION   -------------------------------------------------------------######
# to connect to the mss-service that handles the plugins
# only accessible through socket (PM)

MSS_SOCKET_HOST=/var/www/MatinSubSystem/bootstrap/easySocket/client.sock
# socket host: if the socket was served on port, the value is an ip address, if it's a file the value is the full path of the file
MSS_SOCKET_PORT=0
# socket port: if the socket was served on port, the value is the port range like 1000:1003, if it's a file the value is '0'







######-------------------------------------------------   MNS CONNECTION   -------------------------------------------------------------######
# to connect to the notification-service that handles the notifications

NOTIFICATION_SEND_TYPE=socket
# determines if we want connection to happen via 'http' or 'socket' (PM)

NOTIFICATION_HOST=notification.api
# the url to use when calling a http request.
