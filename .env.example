# determines if the nodes change dynamicaly or staticly. 
# VERY IMPORTANT config. depends on the service. DO NOT change it
QUEUE_CONNECTION=database
# queue handling mechanism
# it has can get different values but we mostly use 'database' or 'sync', depending on the service
SAVE_RAW_RESPONSE=false
# determines if we want to store the raw responses from suppliers (search step)
# the responses will be stored in files in the storage folder
# in dev environments keep it false unless the developer needs it
STORE_LOGS=false
# to store full supplier logs
# ONLY IN DEV environmnts. only for supplier developer.
QUERY_LOGS=false
# to log all the database queries (via log-service)
# keep it false unless it's realy neccessary
SAVE_SUPPLIER_RESPONSE=1800
# the maximum time that search results can be cached (in seconds)
# if you don't wanna use search-result cache youcan set the value to false
# recommended for dev environments
# in production the time is decided by the management
CURL_INTERFACE=0
# the interface ip we might need to use to send our curl requests to the 3rd-party suppliers
CACHE_DRIVER=file
# it's not important in our projects right now but if you remove it there will be exceptions